        <mxCell id="head4" value="&lt;div style=&quot;font-size:21px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;05 · VÒNG ĐỜI &amp;amp; REVIEW&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F0F8F4;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1937" y="166" width="406" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s4_0" value="&lt;div style=&quot;font-size:22px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;Đóng tuyển hoặc hết lịch&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;API-19 / worker · FILLED hoặc&lt;br&gt;EXPIRED theo điều kiện&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1943" y="270" width="394" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4_1" value="&lt;div style=&quot;font-size:22px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;Nếu FILLED&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;NTD xác nhận thực tế đã làm xong&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1943" y="430" width="394" height="130" as="geometry" />
        </mxCell>
        <mxCell id="in4_1" edge="1" parent="1" source="s4_0" target="s4_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#60788D;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4_2" value="&lt;div style=&quot;font-size:22px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;COMPLETED&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;API-19 · không tự động hoàn thành&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1943" y="590" width="394" height="130" as="geometry" />
        </mxCell>
        <mxCell id="in4_2" edge="1" parent="1" source="s4_1" target="s4_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#60788D;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4_3" value="&lt;div style=&quot;font-size:22px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;Đánh giá hai chiều&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;API-20/21 · APPROVED +&lt;br&gt;COMPLETED; mỗi chiều một lần&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1943" y="750" width="394" height="130" as="geometry" />
        </mxCell>
        <mxCell id="in4_3" edge="1" parent="1" source="s4_2" target="s4_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#60788D;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="next4" edge="1" parent="1" source="head3" target="head4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#60788D;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="exceptions-title" value="NHÁNH NGOẠI LỆ VÀ CỔNG PHÊ DUYỆT · KHÔNG PHẢI CÁC BƯỚC BẮT BUỘC NỐI TIẾP" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=25;fontColor=#17365D;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="45" y="960" width="2305" height="48" as="geometry" />
        </mxCell>
        <mxCell id="branch0" value="&lt;div style=&quot;font-size:23px;color:#7650A4;font-weight:bold;line-height:1.24&quot;&gt;A · NTD HOẶC TIN BỊ TỪ CHỐI&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;REJECTED + lý do; không tạo tin nếu NTD chưa duyệt; tin chưa duyệt&lt;br&gt;không public/Matching/nhận đơn. Gửi lại và duyệt lại theo BR45/46&lt;br&gt;đang chờ chốt.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="45" y="1020" width="750" height="205" as="geometry" />
        </mxCell>
        <mxCell id="branch1" value="&lt;div style=&quot;font-size:23px;color:#7650A4;font-weight:bold;line-height:1.24&quot;&gt;B · KHÓA TÀI KHOẢN&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;Admin khóa/mở SV/NTD (API-37*), JWT cũ bị chặn khi LOCKED. Mở&lt;br&gt;khóa không tự duyệt. Tác động lên tin/đơn hiện hữu và token sau mở&lt;br&gt;khóa chờ BR47.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="825" y="1020" width="750" height="205" as="geometry" />
        </mxCell>
        <mxCell id="branch2" value="&lt;div style=&quot;font-size:23px;color:#94651D;font-weight:bold;line-height:1.24&quot;&gt;C · ĐƠN HẾT CƠ HỘI&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;PENDING → JOB_EXPIRED khi không còn mốc bắt đầu tương lai trong&lt;br&gt;các ca đã chọn. Tin vẫn có thể RECRUITING. Worker ghi notification&lt;br&gt;idempotent.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1605" y="1020" width="750" height="205" as="geometry" />
        </mxCell>
        <mxCell id="branch3" value="&lt;div style=&quot;font-size:23px;color:#94651D;font-weight:bold;line-height:1.24&quot;&gt;D · TIN HẾT LỊCH / ĐÓNG TUYỂN&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;Sau kết thúc ca cuối: có ≥1 APPROVED → FILLED, nếu không →&lt;br&gt;EXPIRED. WEEKLY vô hạn không tự hết. Đóng thủ công cần ≥1&lt;br&gt;APPROVED và 0 PENDING.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="45" y="1245" width="750" height="205" as="geometry" />
        </mxCell>
        <mxCell id="branch4" value="&lt;div style=&quot;font-size:23px;color:#94651D;font-weight:bold;line-height:1.24&quot;&gt;E · HỦY TRƯỚC NGÀY CA ĐẦU&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;RECRUITING/FILLED → CANCELLED trước ngày ca đầu (giờ VN). Nếu có&lt;br&gt;đơn phải có lý do; tất cả đơn JOB_CANCELLED, giữ&lt;br&gt;status_before_cancel, decided_at và thông báo.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="825" y="1245" width="750" height="205" as="geometry" />
        </mxCell>
        <mxCell id="branch5" value="&lt;div style=&quot;font-size:23px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;F · BẢO TOÀN LỊCH / DỮ LIỆU&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;Có bất kỳ đơn thì khóa sửa lịch. Không đoán ca/mã địa bàn legacy;&lt;br&gt;không tự APPROVED. Danh mục ngừng dùng giữ FK lịch sử. BR46/50&lt;br&gt;phải chốt trước rollout.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1605" y="1245" width="750" height="205" as="geometry" />
        </mxCell>
        <mxCell id="adminparallel" value="&lt;div style=&quot;font-size:24px;color:#7650A4;font-weight:bold;line-height:1.24&quot;&gt;QUẢN TRỊ XUYÊN SUỐT&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;D15 / D15A–D15C: quản lý tài khoản, xác minh NTD, kiểm duyệt tin, quản lý danh mục (MUST). D15D:&lt;br&gt;Dashboard (SHOULD) — sáu số đếm từ DB, không tạo bảng riêng. API-27–42 là đề xuất.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F7F0FC;strokeColor=#CDBCE2;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="45" y="1480" width="1135" height="190" as="geometry" />
        </mxCell>
        <mxCell id="roadmap" value="&lt;div style=&quot;font-size:24px;color:#245CA6;font-weight:bold;line-height:1.24&quot;&gt;THỨ TỰ TÍCH HỢP THEO SPRINT PLAN V4.0&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;B1–3: D00. B4–5: địa bàn, tài khoản, hồ sơ, Admin nền. B6: đăng tin + lịch + kiểm duyệt + công khai. B7–8:&lt;br&gt;Matching, ứng tuyển, đơn, vòng đời. B9–10: review, thông báo, Dashboard, UX và E2E.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EDF4FC;strokeColor=#A5C1E6;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
