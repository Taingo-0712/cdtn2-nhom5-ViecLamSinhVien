        <mxCell id="db" value="&lt;div style=&quot;font-size:22px;color:#17365D;font-weight:bold;line-height:1.24&quot;&gt;POSTGRESQL 16 · 13 BẢNG MỤC TIÊU (14 CÓ ĐIỀU KIỆN)&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;11 bảng kế thừa: users, student_profiles, employer_profiles, job_categories, job_posts,&lt;br&gt;job_time_slots, student_availability_slots, applications, application_selected_slots, reviews,&lt;br&gt;notifications.&lt;br&gt;+ administrative_provinces / administrative_wards*; business_industries* nếu BR48 duyệt.&lt;br&gt;schema_migrations: kỹ thuật.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EDF4FC;strokeColor=#A5C1E6;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
