        <mxCell id="side-head" value="HỢP ĐỒNG &amp;amp; RÀNG BUỘC" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=26;fontColor=#17365D;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="1620" y="162" width="715" height="42" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;div style=&quot;font-size:22px;color:#245CA6;font-weight:bold;line-height:1.24&quot;&gt;PHẠM VI V4.1&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;49 US · 35 MUST / 1 SHOULD / 13 WON’T&lt;br&gt;115 AC áp dụng (4 lịch sử) · 24 Dxx&lt;br&gt;38 API mục tiêu (01–29, 34–42).&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#A5C1E6;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1620" y="220" width="715" height="145" as="geometry" />
        </mxCell>
        <mxCell id="states" value="&lt;div style=&quot;font-size:23px;color:#17365D;font-weight:bold;line-height:1.24&quot;&gt;4 NHÓM TRẠNG THÁI ĐỘC LẬP&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;users.account_status:&lt;br&gt;ACTIVE / LOCKED&lt;br&gt;job_posts.moderation_status:&lt;br&gt;PENDING / APPROVED / REJECTED&lt;br&gt;job_posts.status: RECRUITING / FILLED /&lt;br&gt;COMPLETED / EXPIRED / CANCELLED&lt;br&gt;applications.status: PENDING / APPROVED /&lt;br&gt;REJECTED / JOB_EXPIRED / JOB_CANCELLED&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1620" y="382" width="715" height="340" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;div style=&quot;font-size:23px;color:#7650A4;font-weight:bold;line-height:1.24&quot;&gt;KIỂM DUYỆT TIN &amp;amp; QUYỀN ĐĂNG&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;NTD ACTIVE, role EMPLOYER được tạo tin.&lt;br&gt;Tin mới RECRUITING / PENDING.&lt;br&gt;Chỉ tin APPROVED, chủ tin ACTIVE và đủ điều kiện&lt;br&gt;mới công khai danh sách, Matching, nhận đơn.&lt;br&gt;Admin không tự đổi vòng đời tin / đơn.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F7F0FC;strokeColor=#CDBCE2;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1620" y="739" width="715" height="202" as="geometry" />
        </mxCell>
        <mxCell id="security" value="&lt;div style=&quot;font-size:23px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;BẢO MẬT VÀ TRANSACTION&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;JWT đối chiếu role, account_status, token_version;&lt;br&gt;token cũ vô hiệu cả sau mở khóa. CV theo quyền.&lt;br&gt;Khóa users → profile → category → job → application;&lt;br&gt;worker chỉ job → đơn. Trạng thái + notification&lt;br&gt;cùng transaction.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F0F8F4;strokeColor=#B9D5C6;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1620" y="958" width="715" height="205" as="geometry" />
        </mxCell>
        <mxCell id="geo" value="&lt;div style=&quot;font-size:23px;color:#245CA6;font-weight:bold;line-height:1.24&quot;&gt;ĐỊA BÀN, LỊCH &amp;amp; THỜI GIAN&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;Mã tỉnh/phường/xã dạng chuỗi, FK ghép; OR giữa&lt;br&gt;nhóm địa bàn, AND lọc khác. 1–21 ca/tin,&lt;br&gt;ca đêm một logic; Asia/Ho_Chi_Minh.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EDF4FC;strokeColor=#A5C1E6;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1620" y="1180" width="715" height="172" as="geometry" />
        </mxCell>
        <mxCell id="approval" value="&lt;div style=&quot;font-size:23px;color:#94651D;font-weight:bold;line-height:1.24&quot;&gt;KIỂM CHỨNG TRƯỚC TRIỂN KHAI&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;BR43/48: seed địa bàn chính thức, danh mục dùng chung.&lt;br&gt;BR46: có đơn thì khóa toàn bộ sửa nội dung tin.&lt;br&gt;BR47: kiểm JWT và quyền tin/đơn sau khóa/mở.&lt;br&gt;BR50: backup/restore, kiểm schema và checksum;&lt;br&gt;giữ V001–V006, không tự APPROVED tin legacy.&lt;br&gt;BR51: kiểm storage, chữ ký và quyền file.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFF5E5;strokeColor=#D9BD86;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1620" y="1369" width="715" height="261" as="geometry" />
        </mxCell>
        <mxCell id="side-note" value="US49 SHOULD · 5 số đếm DB, không bảng riêng.&lt;br&gt;US46 / FR24 / API-30–33 ngoài MVP." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=19;fontColor=#52677C;fontStyle=0;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="1620" y="1640" width="715" height="61" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Căn cứ: SRS v2.1 / phạm vi v4.1 · API Contract / Database Schema / Product Backlog v4.1 · Thiết kế mục tiêu, chưa xác minh triển khai." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontColor=#52677C;fontStyle=0;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="45" y="1741" width="2310" height="43" as="geometry" />
        </mxCell>
