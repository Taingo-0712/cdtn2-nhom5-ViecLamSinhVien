        <mxCell id="head4" value="&lt;div style=&quot;font-size:21px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;05 · VÒNG ĐỜI &amp;amp; REVIEW&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F0F8F4;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1937" y="166" width="406" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s4_0" value="&lt;div style=&quot;font-size:22px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;Đóng tuyển hoặc hết lịch&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;API-19 / worker · FILLED hoặc&lt;br&gt;EXPIRED theo điều kiện&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1943" y="270" width="394" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4_1" value="&lt;div style=&quot;font-size:22px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;Nếu FILLED&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;NTD xác nhận thực tế đã làm xong&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1943" y="430" width="394" height="130" as="geometry" />
        </mxCell>
        <mxCell id="in4_1" edge="1" parent="1" source="s4_0" target="s4_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#60788D;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4_2" value="&lt;div style=&quot;font-size:22px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;COMPLETED&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;API-19 · không tự động hoàn thành&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1943" y="590" width="394" height="130" as="geometry" />
        </mxCell>
        <mxCell id="in4_2" edge="1" parent="1" source="s4_1" target="s4_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#60788D;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4_3" value="&lt;div style=&quot;font-size:22px;color:#237354;font-weight:bold;line-height:1.24&quot;&gt;Đánh giá hai chiều&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;API-20/21 · APPROVED +&lt;br&gt;COMPLETED; mỗi chiều một lần&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D7E4;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
          <mxGeometry x="1943" y="750" width="394" height="130" as="geometry" />
        </mxCell>
