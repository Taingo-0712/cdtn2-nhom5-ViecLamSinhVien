        <mxCell id="db" value="&lt;div style=&quot;font-size:22px;color:#17365D;font-weight:bold;line-height:1.24&quot;&gt;TẦNG 3 · POSTGRESQL 16 — 13 BẢNG NGHIỆP VỤ&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#20364D;line-height:1.24;margin-top:9px&quot;&gt;DB đích: student_jobs_nhom5_v4 • schema public&lt;br&gt;11 bảng kế thừa: users, student_profiles, employer_profiles, job_categories, job_posts,&lt;br&gt;job_time_slots, student_availability_slots, applications, application_selected_slots, reviews,&lt;br&gt;notifications. + administrative_provinces / administrative_wards.&lt;br&gt;schema_migrations: bảng kỹ thuật. Tổng 107 trường nghiệp vụ mục tiêu.&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EDF4FC;strokeColor=#A5C1E6;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;fontColor=#20364D;" parent="1" vertex="1">
