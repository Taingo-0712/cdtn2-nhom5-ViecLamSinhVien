        </mxCell>
        <mxCell id="a118" value="FK ON DELETE RESTRICT. FK địa bàn/lĩnh vực và actor nullable: con tham chiếu 0..1 cha; hồ sơ/tin mới bắt buộc đủ địa bàn, hồ sơ NTD mới bắt buộc lĩnh vực." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#F0F4F8;fontFamily=Arial;fontSize=15;fontColor=#536A7B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1065" width="1255" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a119" value="BR48 — DANH MỤC DÙNG CHUNG (ĐÃ CHỐT)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#FFF1D6;fontFamily=Arial;fontSize=19;fontColor=#9A641B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="1129" width="1255" height="39" as="geometry" />
        </mxCell>
        <mxCell id="a120" value="job_categories.category_id → employer_profiles.industry_id&#10;API-29: ánh xạ danh mục đang hoạt động sang industry_id." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#E4F6F4;fontFamily=Arial;fontSize=17;fontColor=#087E83;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="1184" width="1255" height="54" as="geometry" />
        </mxCell>
        <mxCell id="a121" value="job_categories.category_id → job_posts.category_id&#10;API-07: chọn mới chỉ active; lọc lịch sử có thể gồm inactive." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#F0F4F8;fontFamily=Arial;fontSize=17;fontColor=#17365C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="1252" width="1255" height="54" as="geometry" />
        </mxCell>
        <mxCell id="a122" value="13 bảng nghiệp vụ, không tạo business_industries. Không xóa cứng danh mục được tham chiếu.&#10;FR27 / API-38–40 quản lý danh mục dùng chung; giữ ID và lịch sử." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#FFF1D6;fontFamily=Arial;fontSize=16;fontColor=#536A7B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1350" width="1255" height="54" as="geometry" />
        </mxCell>
        <mxCell id="a123" value="01  Tài khoản / kiểm duyệt tin" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#087E83;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="130" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a124" value="users.account_status: ACTIVE / LOCKED. NTD ACTIVE đúng role EMPLOYER được tạo tin.&#10;moderation_status: PENDING / APPROVED / REJECTED, độc lập với job_posts.status.&#10;Admin ghi actor, thời điểm và lý do từ chối; không có trạng thái xác minh NTD." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#D5E1EA;fillColor=#E4F6F4;fontFamily=Arial;fontSize=16;fontColor=#18334D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1405" y="166" width="1150" height="92" as="geometry" />
        </mxCell>
        <mxCell id="a125" value="02  Địa bàn và danh mục" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#087E83;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="273" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a126" value="FK tỉnh + FK ghép (province_code, ward_code) → wards. UNIQUE cặp mã ở wards.&#10;VARCHAR(16) giữ số 0 đầu; không đoán địa bàn legacy. is_active=FALSE không chọn mới.&#10;Seed nguồn chính thức; kiểm chứng phiên bản, mã duy nhất, encoding trước migration." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#D5E1EA;fillColor=#E4F6F4;fontFamily=Arial;fontSize=16;fontColor=#18334D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1405" y="309" width="1150" height="92" as="geometry" />
        </mxCell>
        <mxCell id="a127" value="03  Lịch ca và Matching" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#17365C;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="416" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a128" value="WEEKLY / ONE_TIME: 1–21 ca; SV 0–21 khoảng. Ca đêm là một bản ghi; chống overlap CN→T2.&#10;UQ ca theo shape; giờ bắt đầu khác kết thúc; không dùng 24:00. Matching ANY/ALL trọn một khoảng.&#10;Không lưu match_percent; tin legacy không suy lịch từ work_time." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#D5E1EA;fillColor=#F0F4F8;fontFamily=Arial;fontSize=16;fontColor=#18334D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1405" y="452" width="1150" height="92" as="geometry" />
        </mxCell>
        <mxCell id="a129" value="04  Ứng tuyển và CV" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#17365C;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="559" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a130" value="UQ(student_id, job_id), UQ(cv_storage_key); PDF ≤5 MiB, lưu riêng tư.&#10;PK kép (application_id, job_slot_id); Service kiểm ca cùng job; giữ lựa chọn lịch sử.&#10;Khóa toàn bộ sửa nội dung tin khi có bất kỳ đơn; duyệt muộn giữ decided_at." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#D5E1EA;fillColor=#F0F4F8;fontFamily=Arial;fontSize=16;fontColor=#18334D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1405" y="595" width="1150" height="92" as="geometry" />
        </mxCell>
        <mxCell id="a131" value="05  Vòng đời và thời gian" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#17365C;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="702" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a132" value="Tin: RECRUITING / FILLED / COMPLETED / EXPIRED / CANCELLED.&#10;Đơn: PENDING / APPROVED / REJECTED / JOB_EXPIRED / JOB_CANCELLED.&#10;Hết cơ hội ca chọn → JOB_EXPIRED; qua ca cuối → FILLED nếu có APPROVED, ngược lại EXPIRED.&#10;WEEKLY vô hạn không tự hết; đóng thủ công cần ≥1 APPROVED, 0 PENDING." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#D5E1EA;fillColor=#F0F4F8;fontFamily=Arial;fontSize=16;fontColor=#18334D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1405" y="738" width="1150" height="108" as="geometry" />
        </mxCell>
        <mxCell id="a133" value="06  Hủy, đánh giá và thông báo" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#17365C;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="861" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a134" value="Hủy trước NGÀY ca đầu theo giờ VN, lý do nếu có đơn; mọi đơn JOB_CANCELLED.&#10;Giữ status_before_cancel, decided_at; transaction gồm cập nhật và notifications.&#10;Review chỉ COMPLETED + APPROVED; UQ(application_id, reviewer_id), mỗi chiều 1 lần." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#D5E1EA;fillColor=#F0F4F8;fontFamily=Arial;fontSize=16;fontColor=#18334D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1405" y="897" width="1150" height="92" as="geometry" />
        </mxCell>
        <mxCell id="a135" value="07  Bảo mật và đồng thời" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#087E83;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="1004" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a136" value="CV riêng tư; logo tùy chọn ≤2 MiB. JWT token_version khớp DB; tăng khi khóa, token cũ vô hiệu.&#10;Lock users → employer_profiles → danh mục → job_posts → applications; worker job → đơn.&#10;Worker idempotent; rollback DB + dọn file mới khi lỗi; không tự COMPLETED." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#D5E1EA;fillColor=#E4F6F4;fontFamily=Arial;fontSize=16;fontColor=#18334D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1405" y="1040" width="1150" height="92" as="geometry" />
        </mxCell>
        <mxCell id="a137" value="08  Chuyển tiếp và kiểm chứng D00" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=#087E83;fontFamily=Arial;fontSize=18;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="1147" width="1150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a138" value="DB đích student_jobs_nhom5_v4 sao chép từ student_jobs_nhom5; giữ DB nguồn và storage.&#10;Giữ migration V001–V006; kiểm tra checksum, schema, seed địa bàn trước migration mới.&#10;Không tự APPROVED tin legacy; giữ lịch sử, không tự suy mã địa bàn hoặc lịch ca." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#D5E1EA;fillColor=#E4F6F4;fontFamily=Arial;fontSize=16;fontColor=#18334D;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1405" y="1183" width="1150" height="92" as="geometry" />
        </mxCell>
        <mxCell id="a139" value="Nguồn: Database Schema v4.1 §2–12 • SRS v2.1/phạm vi v4.1 • API Contract v4.1.  Thiết kế mục tiêu; chưa migration/test thực tế." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontColor=#536A7B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="1440" width="2510" height="43" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>