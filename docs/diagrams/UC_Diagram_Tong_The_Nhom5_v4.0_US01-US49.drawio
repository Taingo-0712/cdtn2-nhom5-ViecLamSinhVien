  <diagram id="page2" name="03 - Quy tắc và điều kiện UC">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1130" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="QUY TẮC &amp;amp; ĐIỀU KIỆN USE CASE | v4.0" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=29;fontColor=#173C58;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1540" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Luồng nghiệp vụ được mô tả bằng điều kiện trước/sau; không biến worker hoặc kiểm tra quyền thành tác nhân." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#536B7E;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="1540" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F4F7FA;strokeColor=#C6D4DE;fontFamily=Arial;fontSize=18;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="750" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="01  Tài khoản / quyền" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=21;fontColor=#173C58;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="42" y="130" width="726" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="UC01a, UC01b, UC19a/b · FR1, FR26" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#077C83;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="42" y="172" width="726" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="NTD mới PENDING; chỉ ACTIVE + APPROVED được đăng tin.&lt;br&gt;LOCKED chặn API bảo vệ kể cả JWT cũ; mở khóa không tự duyệt.&lt;br&gt;Guest quay lại đúng tin sau login/register SV; tải lại dữ liệu.&lt;br&gt;BR45/47/51: chính sách gửi lại, file, khóa NTD còn chờ chốt." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="42" y="215" width="726" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F4F7FA;strokeColor=#C6D4DE;fontFamily=Arial;fontSize=18;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="805" y="120" width="750" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="02  Công khai / địa bàn" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=21;fontColor=#173C58;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="817" y="130" width="726" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="UC03a–d, UC17 · FR3, FR22" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#077C83;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="817" y="172" width="726" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="Trang chủ hợp nhất /; /jobs chuyển hướng tương thích.&lt;br&gt;Tin công khai phải đã duyệt và đủ điều kiện tương ứng;&lt;br&gt;Trang chủ/Matching chỉ tin đang tuyển đủ điều kiện nhận đơn.&lt;br&gt;OR nhóm tỉnh/phường; AND lọc khác. BR43/50 chờ chốt kỹ thuật." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="817" y="215" width="726" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F4F7FA;strokeColor=#C6D4DE;fontFamily=Arial;fontSize=18;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="415" width="750" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="03  Xác minh / kiểm duyệt" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=21;fontColor=#173C58;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="42" y="425" width="726" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="UC20, UC21, UC02a/b, UC13a/b · FR24/25" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#077C83;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="42" y="467" width="726" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="Admin xem hồ sơ/minh chứng, duyệt hoặc từ chối kèm lý do.&lt;br&gt;Tin mới RECRUITING + PENDING; duyệt không đổi vòng đời.&lt;br&gt;Không công khai, Matching, nhận đơn với tin chưa duyệt.&lt;br&gt;BR45/46/47/50/51: chốt gửi lại, sửa sau duyệt, legacy, bảo mật." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="42" y="510" width="726" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F4F7FA;strokeColor=#C6D4DE;fontFamily=Arial;fontSize=18;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="805" y="415" width="750" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="04  Lịch / ứng tuyển" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=21;fontColor=#173C58;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="817" y="425" width="726" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="UC16, UC15, UC17, UC04 · FR4/20/21/22" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#077C83;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="817" y="467" width="726" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="WEEKLY / ONE_TIME; ca đêm một ca logic. ANY/ALL trọn ca.&lt;br&gt;Matching chỉ gợi ý; SV chọn ca tương lai, CV PDF ≤5 MiB.&lt;br&gt;Một đơn / SV / tin; khóa sửa lịch sau bất kỳ đơn.&lt;br&gt;Duyệt muộn cần xác nhận; ca đã qua không hiệu lực." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="817" y="510" width="726" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F4F7FA;strokeColor=#C6D4DE;fontFamily=Arial;fontSize=18;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="710" width="750" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="05  Vòng đời / lịch sử" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=21;fontColor=#173C58;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="42" y="720" width="726" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="UC05a–c, UC06a–d, UC18, UC08 · FR5/6/8/23" style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#077C83;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="42" y="762" width="726" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="Đơn hết mọi cơ hội ca chọn → JOB_EXPIRED. Sau ca cuối: &lt;br&gt;FILLED nếu có APPROVED, nếu không → EXPIRED.&lt;br&gt;WEEKLY vô hạn không tự hết; NTD xác nhận hoàn thành.&lt;br&gt;Đóng thủ công ≥1 APPROVED, 0 PENDING. Hủy trước ngày ca đầu,&lt;br&gt;lý do nếu có đơn; JOB_CANCELLED, giữ lịch sử, thông báo." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
