        <mxCell id="n26" value="Danh mục ngừng dùng, không xóa cứng khi có tham chiếu.&lt;br&gt;Đánh giá hai chiều chỉ với COMPLETED + APPROVED.&lt;br&gt;Dashboard SHOULD: 6 số đếm thực từ DB, không có bảng riêng.&lt;br&gt;BR48 còn mở: danh mục lĩnh vực NTD dùng chung hay riêng." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#18354A;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
