        <mxCell id="n52" value="UC19a/b, UC20–22: MUST&lt;br&gt;UC23: SHOULD (6 số đếm DB)&lt;br&gt;Admin không tự xem CV/lịch rảnh SV.&lt;br&gt;API mới: chờ phê duyệt hợp đồng." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C8D5DE;fontFamily=Arial;fontSize=16;fontColor=#536B7E;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
