        </mxCell>
        <mxCell id="n53" value="CHÚ GIẢI: Nét liền = liên kết tác nhân–UC; nền xanh ngọc = UC mới MUST; nền vàng nét đứt = SHOULD." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=17;fontColor=#173C58;fontStyle=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1350" width="1740" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="UC01a, UC01b, UC03a–d xuất hiện ở nhiều cột để dễ đọc: cùng mã là cùng một Use Case, không phải chức năng mới.&lt;br&gt;Không biểu diễn 12 WON’T thành UC triển khai. Worker hết hạn là xử lý nội bộ. Không dùng include/extend để diễn tả thứ tự nghiệp vụ." style="html=1;whiteSpace=wrap;rounded=0;arcSize=8;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#536B7E;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1387" width="1740" height="67" as="geometry"/>
        </mxCell>
      </root>
